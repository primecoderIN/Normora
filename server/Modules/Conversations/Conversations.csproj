<Project Sdk="Microsoft.NET.Sdk">

  <!-- Owns conversational RAG use cases, conversation persistence, LLM adapters, and answer exports. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Normora.Shared\Normora.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="QuestPDF" Version="2025.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Normora.Modules.Conversations</AssemblyName>
    <RootNamespace>Normora.Modules.Conversations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Normora.Shared.Authorization" />
    <Using Include="Normora.Modules.Conversations.Application.Conversations.Commands" />
    <Using Include="Normora.Modules.Conversations.Application.Conversations.DTOs" />
    <Using Include="Normora.Modules.Conversations.Application.Conversations.Queries" />
    <Using Include="Normora.Modules.Conversations.Application.SavedAnswers.Commands" />
    <Using Include="Normora.Modules.Conversations.Application.SavedAnswers.DTOs" />
    <Using Include="Normora.Modules.Conversations.Application.SavedAnswers.Queries" />
    <Using Include="Normora.Modules.Conversations.Application.Suggestions.Queries" />
  </ItemGroup>

</Project>
