<Project Sdk="Microsoft.NET.Sdk">

  <!-- Owns document lifecycle, ingestion, retrieval contracts, and document persistence. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Normora.Shared\Normora.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Normora.Modules.Documents</AssemblyName>
    <RootNamespace>Normora.Modules.Documents</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Normora.Shared.Authorization" />
    <Using Include="Normora.Modules.Documents.Domain" />
    <Using Include="Normora.Modules.Documents.Application.Services" />
    <Using Include="Normora.Modules.Documents.Application.Documents.Commands" />
    <Using Include="Normora.Modules.Documents.Application.Documents.DTOs" />
    <Using Include="Normora.Modules.Documents.Application.Documents.Queries" />
    <Using Include="Normora.Modules.Documents.Application.Chunks.DTOs" />
    <Using Include="Normora.Modules.Documents.Application.Chunks.Queries" />
    <Using Include="Normora.Modules.Documents.Application.Mcp.Queries" />
    <Using Include="Normora.Modules.Documents.Application.Metrics.Queries" />
  </ItemGroup>

</Project>
