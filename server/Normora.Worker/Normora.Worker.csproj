<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs Hangfire background jobs independently from the HTTP API process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Normora.Api\Normora.Api.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Hangfire.Core" Version="1.8.21" />
    <!-- Pin secure version of Newtonsoft.Json to remediate GHSA-5crp-9r3c-p9vr pulled transitively by Hangfire -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
